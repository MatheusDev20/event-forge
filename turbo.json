{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "type-check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      // Contracts compile to dist before the watchers start, so the server and
      // web app find @repo/contracts on their first boot rather than crashing
      // and being restarted by the watcher.
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_BACKEND_URL",
    "NEXT_PUBLIC_STOREFRONT_URL",
    "NODE_ENV",
    "PORT",
    "DB_HOST",
    "DB_PORT",
    "DB_USERNAME",
    "DB_PASSWORD",
    "DB_NAME",
    "DB_POOL_SIZE",
    "THROTTLE_TTL_MS",
    "THROTTLE_LIMIT",
    "UPLOADS_DIR",
    "PUBLIC_BASE_URL",
    "S3_UPLOAD",
    "S3_BUCKET",
    "S3_REGION",
    "S3_KEY_PREFIX",
    "S3_PUBLIC_BASE_URL",
    "S3_ENDPOINT"
  ]
}
