# Copy to apps/server/.env:  cp apps/server/.env.example apps/server/.env
#
# Every value here is validated at boot against the schema in src/config/env.ts.
# A missing or malformed value fails the process by name instead of surfacing
# later as `undefined` inside a connection string.

# Port the API listens on. apps/web takes 3000 (next dev's default), so the
# server uses 3001 to avoid a clash when both run under `turbo dev`.
PORT=3001

# Origin allowed by CORS. Must match where the web app is served from.
WEB_ORIGIN=http://localhost:3000

# Database. Matches the defaults in docker-compose.yml, so `pnpm db:up` brings
# up a Postgres these values connect to out of the box.
#
# Unlike the template this came from, the database is NOT optional: the app
# fails to boot without it. Run `pnpm db:up && pnpm db:migrate && pnpm db:seed`.
DB_HOST=localhost
# Host port is 5433 by default to avoid colliding with a Postgres already
# running on the standard 5432. The container still listens on 5432 internally.
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=event_forge_db
# How many Postgres connections this process holds open. TypeORM's default is
# 10, which is fewer than the concurrent requests the hold race fires — with a
# small pool most of them queue in the driver, the row lock is never contended,
# and the experiment measures pool scheduling instead of locking. Lowering this
# on purpose is a valid experiment; inheriting it by accident is not.
DB_POOL_SIZE=50

# Rate limiting: requests per window, per client. THROTTLE_LIMIT=0 disables the
# guard, which is the only honest setting for a concurrency benchmark — the
# hold race fires N simultaneous requests from one client, which is precisely
# the traffic the guard exists to refuse, and its 429s would be indistinguishable
# from a seat being taken.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# ---------------------------------------------------------------------------
# Uploads (event hero art)
#
# Two backends behind one switch. Either way what lands in
# events.hero_image_url is an absolute URL a browser can fetch, so flipping the
# switch changes where new images go and leaves existing rows working.
# ---------------------------------------------------------------------------

# false: write to the local disk. true: write to S3 (S3_BUCKET and S3_REGION
# then become required, and the server refuses to boot without them).
S3_UPLOAD=false

# --- Local backend ---------------------------------------------------------

# Where images are written. Relative paths resolve against the process working
# directory, which for `pnpm dev` is apps/server. Created on first upload, and
# gitignored.
UPLOADS_DIR=./uploads

# Origin this API is reachable at. It prefixes every locally stored
# hero_image_url, so it must match PORT above — a wrong value here outlives the
# process that wrote it, as a column full of URLs that resolve to nothing.
# Must include the scheme: "localhost:3001" is refused at boot.
PUBLIC_BASE_URL=http://localhost:3001

# --- S3 backend (only read when S3_UPLOAD=true) ----------------------------

# S3_BUCKET=event-forge-media
# S3_REGION=sa-east-1

# Key prefix inside the bucket. Defaults to hero-images.
# S3_KEY_PREFIX=hero-images

# Where those objects are publicly readable — a CloudFront distribution or a
# custom domain. Leave unset to address the bucket directly, which only works
# if its objects are publicly readable.
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# A non-AWS S3 endpoint (MinIO, LocalStack). Setting it also switches to
# path-style addressing, which those need.
# S3_ENDPOINT=http://localhost:9000

# Credentials are NOT read from here. The AWS SDK's own provider chain finds
# them (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, ~/.aws/credentials, or an
# instance or task role) — and a role is the right answer wherever there is one.
