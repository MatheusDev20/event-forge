# Copy to apps/server/.env:  cp apps/server/.env.example apps/server/.env
#
# Every value here is validated at boot against the schema in src/config/env.ts.
# A missing or malformed value fails the process by name instead of surfacing
# later as `undefined` inside a connection string.

# Port the API listens on. apps/web takes 3000 (next dev's default), so the
# server uses 3001 to avoid a clash when both run under `turbo dev`.
PORT=3001

# Origin allowed by CORS. Must match where the web app is served from.
WEB_ORIGIN=http://localhost:3000

# Database. Matches the defaults in docker-compose.yml, so `pnpm db:up` brings
# up a Postgres these values connect to out of the box.
#
# Unlike the template this came from, the database is NOT optional: the app
# fails to boot without it. Run `pnpm db:up && pnpm db:migrate && pnpm db:seed`.
DB_HOST=localhost
# Host port is 5433 by default to avoid colliding with a Postgres already
# running on the standard 5432. The container still listens on 5432 internally.
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=event_forge_db
