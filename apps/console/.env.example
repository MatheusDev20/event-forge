# Copy to .env.local (gitignored):
#
#   cp apps/console/.env.example apps/console/.env.local
#
# Base URL the browser uses to reach the NestJS API. Must match the server's
# PORT (apps/server/.env, default 3001). NEXT_PUBLIC_ vars are inlined into the
# client bundle at build time, so never put secrets here.
#
# The same API the storefront reads. There is no separate B2B backend: Catalog
# already exposes the write endpoints this console drives (create, publish,
# on-sale, hero image), and splitting the API would mean two services owning
# one bounded context. See docs/adr/0001-modular-monolith.md.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001/api/v1

# Where the public storefront runs (apps/web, default 3000). The console links
# to it so an organizer can check how a published event actually looks. A plain
# link rather than a route, because it is a different app on a different origin.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
