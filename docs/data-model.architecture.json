  "cards": [
    {
      "dot": "cyan",
      "title": "Catalog — what exists",
      "items": [
        "Two chains: a room (venues → seats) and a sale (organizers → events → price_tiers)",
        "Foreign keys and cascades throughout; a general-admission section has capacity but no rows or seats"
      ]
    },
    {
      "dot": "amber",
      "title": "The gap — ADR-0001 + ADR-0006",
      "items": [
        "allocations.event_id and holds.event_id are plain uuids with no foreign key",
        "Publish copies the labels rather than pointing at them, so a ticket survives the venue being re-lettered"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inventory — what is free",
      "items": [
        "One allocation row per seat (capacity 1); one row per GA section (capacity 500) — the hot row",
        "held and reserved are the only mutable numbers in the schema; holds are the ledger of who moved them"
      ]
    }
  ]
