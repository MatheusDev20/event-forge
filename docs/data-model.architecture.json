        "focus": [
          "organizers",
          "events",
          "price_tiers",
          "price_tier_sections",
          "sections"
        ],
        "note": "An event happens in a room on a date, and every section it sells must carry a price."
      },
      {
        "id": "the-gap",
        "label": "3. The gap",
        "focus": [
          "events",
          "seats",
          "allocations"
        ],
        "note": "Publishing copies the layout into stock. Nothing joins the two halves afterwards."
      },
      {
        "id": "the-claim",
        "label": "4. The claim",
        "focus": [
          "allocations",
          "holds",
          "hold_lines"
        ],
        "note": "Holds are a ledger of who moved the numbers on an allocation row."
      },
      {
        "id": "contended",
        "label": "5. The contended row",
        "focus": [
          "allocations",
          "hold_lines"
        ],
        "note": "held and reserved are the only mutable numbers in the schema. Everything else is written once."
      }
    ]
